{
	"name": "groundtruth-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "GROUNDTRUTH frontend, served as static assets by Wrangler",
	"scripts": {
		"build": "tsc --noEmit && vite build",
		"dev": "vite build --watch --mode development & wrangler dev --port 8788",
		"deploy": "npm run build && wrangler deploy",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"geotiff": "^2.1.3"
	},
	"devDependencies": {
		"typescript": "^5.6.0",
		"vite": "^5.4.0",
		"wrangler": "^4.162.0"
	}
}

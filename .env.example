# -------------------------------------------------------------------
# GROUNDTRUTH local environment
#
# Copy to .env (scripts/setup.sh does this for you):
#     cp .env.example .env
#
# This file is for LOCAL DOCKER COMPOSE ONLY.
# Production Cloudflare secrets belong in Cloudflare secret storage.
#
# Scientific parameters (AOI, polarization, thresholds) do NOT belong
# here. They live in configs/*.yaml so an analysis is reproducible
# from its config file alone.
# -------------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# --- Paths inside the container (mounted from the host) -------------
# Host ./data  -> /data        (read-write)
# Host ./configs -> /configs   (read-only)
DATA_ROOT=/data
CONFIG_ROOT=/configs

# --- Host-side paths used by docker compose -------------------------
# Change these only if your data lives outside the repository.
HOST_DATA_DIR=./data
HOST_CONFIG_DIR=./configs

# --- Scientific processing ------------------------------------------
PROCESSING_TILE_SIZE=1024
PROCESSING_MAX_WORKERS=2

# --- NASA Earthdata --------------------------------------------------
# Credentials are supplied as a .netrc file mounted read-only, never as
# a password in this file. Put your real .netrc path here, or leave the
# default and edit ./secrets/netrc (gitignored).
# Format:
#   machine urs.earthdata.nasa.gov login YOUR_USER password YOUR_PASS
EARTHDATA_NETRC_FILE=./secrets/netrc
EARTHDATA_NETRC_PATH=/run/secrets/earthdata_netrc

# --- Artifact publication --------------------------------------------
# Results are POSTed to the Cloudflare Worker, which writes them to R2
# through its native binding. This container holds NO R2 credentials:
# an S3 access key here would be a key too many.
#
# Leave both blank for local-only processing; output then stays in
# data/processed. Not needed for the selftest.
WORKER_API_URL=
PROCESSOR_SHARED_SECRET=

# --- Local service ports ---------------------------------------------
PROCESSOR_PORT=8000
FRONTEND_PORT=5173
